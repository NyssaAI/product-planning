#!/usr/bin/env bash
set -euo pipefail

# Pre-push guard for the dev-tools plugin.
#
# Version bumps happen ONCE per release on main (run scripts/bump-version.sh
# <next>, then tag + publish) — never per feature branch. A single linear
# release counter cannot be assigned per parallel branch without collisions
# (two open branches would both pick the same next number and conflict on the
# version files), so this hook does NOT require a version change just because
# releasable files changed.
#
# It only enforces that the declared version files stay in sync (no drift),
# which catches a half-edited version state regardless of branch.

ROOT="$(git rev-parse --show-toplevel)"
"$ROOT/scripts/bump-version.sh" --check
