{
  "version": 1,
  "paths": {
    "repoRoot": ".",
    "product": "docs/product.md",
    "features": "docs/features.md",
    "techStack": "docs/tech-stack.md",
    "featureDocs": "docs/features",
    "roadmap": "docs/roadmap.md",
    "configSchema": ".plan-product/schema.json",
    "templates": ".plan-product/templates",
    "productTemplate": ".plan-product/templates/product.md",
    "featuresTemplate": ".plan-product/templates/features.md",
    "techStackTemplate": ".plan-product/templates/tech-stack.md",
    "featureTemplate": ".plan-product/templates/feature.md",
    "useCaseTemplate": ".plan-product/templates/use-case.md",
    "roadmapTemplate": ".plan-product/templates/roadmap.md"
  },
  "structure": {
    "features": {
      "inventory": "docs/features.md",
      "root": "docs/features",
      "idPattern": "F-Nxx",
      "folderPattern": "f-nxx",
      "featureFile": "feature.md",
      "featurePathPattern": "docs/features/f-nxx/feature.md",
      "useCaseIdPattern": "UC-nnn",
      "useCaseFilePattern": "uc-nnn-short-slug.md",
      "useCasePathPattern": "docs/features/f-nxx/uc-nnn-short-slug.md"
    },
    "roadmap": {
      "file": "docs/roadmap.md",
      "idPattern": "R-NNN"
    }
  }
}
