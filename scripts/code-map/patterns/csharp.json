{
  "patterns": [
    {
      "id": "csharp-http-attributed-method",
      "name": "HTTP attributed method",
      "language": "CSharp",
      "confidence": "high",
      "description": "A C# method carries an HTTP route attribute.",
      "rule": {
        "kind": "method_declaration",
        "has": {
          "kind": "attribute_list",
          "regex": "Http(Get|Post|Put|Delete|Patch)|Route"
        }
      },
      "tags": ["http", "controller"]
    },
    {
      "id": "csharp-public-surface-method",
      "name": "Public surface method",
      "language": "CSharp",
      "confidence": "intent-only",
      "description": "A public method is visible as surface-area evidence but does not prove a higher-level pattern.",
      "includeInHeadline": false,
      "rule": {
        "kind": "method_declaration",
        "all": [
          { "has": { "field": "name", "pattern": "$NAME" } },
          { "has": { "kind": "modifier", "regex": "^public$" } }
        ]
      },
      "tags": ["public-surface"]
    }
  ]
}
